{
  "name": "agentos-lite",
  "version": "0.6.6",
  "private": true,
  "description": "有代码依据的 Windows 多 Agent 项目学习助手",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test:ui": "node tests/ui-smoke.cjs",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mermaid": "^11.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.51.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "local.agentos.lite",
    "productName": "AgentOS Lite",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/mermaid/dist/mermaid.min.js"
    ],
    "extraResources": [
      {
        "from": "backend-dist-v0.6.6",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release-v0.6.6"
    }
  }
}
